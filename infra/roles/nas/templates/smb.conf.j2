[global]
    server role = standalone server
    security = user
    map to guest = Never
    server min protocol = SMB2
    load printers = no
    disable spoolss = yes

{% for share in samba_shares %}
[{{ share.name }}]
    path = {{ share.path }}
    valid users = {{ share.user }}
    guest ok = no
    browseable = yes
    read only = no
    create mask = 0600
    directory mask = 0700

{% endfor %}
