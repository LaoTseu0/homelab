[global]
    server role = standalone server
    security = user
    map to guest = Never
    server min protocol = SMB2
    load printers = no
    disable spoolss = yes
    passdb backend = tdbsam
    private dir = /srv/samba/private
    state directory = /srv/samba

{% for account in nas_smb_users %}
[{{ account.share }}]
    path = /srv/partages/{{ account.directory }}
    valid users = {{ account.name }}
    guest ok = no
    read only = no
    create mask = 0600
    directory mask = 0700

{% endfor %}
