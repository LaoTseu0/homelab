[global]
    server role = standalone server
    security = user
    map to guest = Never
    server min protocol = SMB2
    load printers = no
    disable spoolss = yes
    passdb backend = tdbsam
    private dir = {{ samba_state_dir }}/private
    state directory = {{ samba_state_dir }}

{% for account in samba_users %}
[{{ account.share }}]
    path = {{ samba_shares_root }}/{{ account.directory }}
    valid users = {{ account.name }}
    guest ok = no
    read only = no
    create mask = 0600
    directory mask = 0700

{% endfor %}
