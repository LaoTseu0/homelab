services: # Applications du projet Compose.
  registry: # Nom du service.
    image: "{{ registry_image }}" # Référence définie dans les variables du NAS.
    restart: unless-stopped # Redémarre le conteneur après une panne ou un redémarrage de Docker.
    ports:
      - "{{ registry_lan_ip }}:5000:5000" # Publie le port sur l’adresse Homelab du NAS.
    environment:
      REGISTRY_LOG_LEVEL: info # Niveau de détail des journaux.
      OTEL_TRACES_EXPORTER: none # Désactive l’envoi de traces vers un collecteur externe.
      REGISTRY_HTTP_TLS_CERTIFICATE: /tls/registry.crt # Certificat présenté aux clients.
      REGISTRY_HTTP_TLS_KEY: /tls/registry.key # Clé privée utilisée par le serveur.
      REGISTRY_AUTH: htpasswd # Active l’authentification par mot de passe.
      REGISTRY_AUTH_HTPASSWD_REALM: Homelab Registry # Nom annoncé aux clients lors de l’authentification.
      REGISTRY_AUTH_HTPASSWD_PATH: /auth/htpasswd # Fichier des comptes et de leurs hashes.
    labels:
      homelab.registry.auth-checksum: "{{ registry_auth_file.stat.checksum | default('pending') }}" # Compose recrée le conteneur si le fichier des comptes change.
    volumes:
      - type: bind # Relie directement un dossier du NAS au conteneur.
        source: /srv/appdata/registry # Images stockées sur le NVMe.
        target: /var/lib/registry # Chemin de stockage utilisé dans le conteneur.
        bind:
          create_host_path: false # Exige que le dossier source ait été préparé.
      - type: bind
        source: /srv/registry/tls # Clé et certificat préparés par Ansible sur le NVMe.
        target: /tls # Chemin utilisé par les paramètres TLS du conteneur.
        read_only: true # Le conteneur lit les certificats.
        bind:
          create_host_path: false
      - type: bind
        source: /srv/registry/auth # Fichier htpasswd préparé à partir de Vault.
        target: /auth # Chemin utilisé par la configuration d’authentification.
        read_only: true # Le conteneur lit les comptes.
        bind:
          create_host_path: false
  registry-reader: # Le service de téléchargement utilise les mêmes images sur le NVMe.
    image: "{{ registry_image }}"
    restart: unless-stopped
    ports:
      - "{{ registry_lan_ip }}:5001:5000" # Les clients téléchargent les images sur le port 5001.
    environment:
      REGISTRY_LOG_LEVEL: info
      OTEL_TRACES_EXPORTER: none
      REGISTRY_HTTP_TLS_CERTIFICATE: /tls/registry.crt
      REGISTRY_HTTP_TLS_KEY: /tls/registry.key
      REGISTRY_AUTH: htpasswd
      REGISTRY_AUTH_HTPASSWD_REALM: Homelab Registry Pull
      REGISTRY_AUTH_HTPASSWD_PATH: /auth/htpasswd
      REGISTRY_STORAGE_MAINTENANCE: | # Distribution 3.1.2 attend ces réglages dans un seul bloc YAML.
        readonly:
          enabled: true
        uploadpurging:
          enabled: false
    labels:
      homelab.registry.auth-checksum: "{{ registry_reader_auth_file.stat.checksum | default('pending') }}"
    volumes:
      - type: bind
        source: /srv/appdata/registry
        target: /var/lib/registry
        read_only: true # Docker interdit aussi l’écriture dans le dossier des images.
        bind:
          create_host_path: false
      - type: bind
        source: /srv/registry/tls
        target: /tls
        read_only: true
        bind:
          create_host_path: false
      - type: bind
        source: /srv/registry/reader-auth
        target: /auth
        read_only: true
        bind:
          create_host_path: false
