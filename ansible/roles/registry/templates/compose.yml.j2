# Géré par Ansible (rôle registry) : modifier le rôle ou ses variables, pas ce fichier.
services: # Conteneurs du projet Compose.
  registry: # Service de publication, en lecture et écriture.
    image: "{{ registry_image }}" # Image fixée par digest dans les variables de l'hôte.
    restart: unless-stopped # Redémarre le conteneur sauf s'il a été arrêté volontairement.
    ports: # Ports publiés sur l'hôte.
      - "{{ registry_lan_ip }}:{{ registry_push_port }}:5000" # Publié seulement sur l'adresse Homelab.
    environment: # Réglages de Distribution.
      REGISTRY_LOG_LEVEL: info # Niveau de détail des journaux.
      OTEL_TRACES_EXPORTER: none # Désactive l'envoi de traces vers un collecteur.
      REGISTRY_HTTP_TLS_CERTIFICATE: /tls/registry.crt # Certificat présenté aux clients.
      REGISTRY_HTTP_TLS_KEY: /tls/registry.key # Clé privée du serveur.
      REGISTRY_AUTH: htpasswd # Authentification par fichier de comptes.
      REGISTRY_AUTH_HTPASSWD_REALM: Homelab Registry # Nom annoncé aux clients.
      REGISTRY_AUTH_HTPASSWD_PATH: /auth/htpasswd # Fichier des comptes de publication.
    labels: # Étiquettes du conteneur.
      homelab.registry.auth-checksum: "{{ registry_auth_files.results[0].stat.checksum | default('pending') }}" # Change avec les comptes et force la recréation.
    volumes: # Dossiers de l'hôte montés dans le conteneur.
      - type: bind # Montage direct d'un dossier de l'hôte.
        source: "{{ registry_data_dir }}" # Images stockées sur l'hôte.
        target: /var/lib/registry # Emplacement attendu par Distribution.
        bind: # Options du montage.
          create_host_path: false # Exige que le dossier ait été préparé par Ansible.
      - type: bind # Montage direct d'un dossier de l'hôte.
        source: "{{ registry_root }}/tls" # Clé et certificat.
        target: /tls # Chemin utilisé par les réglages TLS.
        read_only: true # Le conteneur ne fait que lire.
        bind: # Options du montage.
          create_host_path: false # Exige que le dossier ait été préparé par Ansible.
      - type: bind # Montage direct d'un dossier de l'hôte.
        source: "{{ registry_root }}/auth" # Comptes de publication.
        target: /auth # Chemin utilisé par l'authentification.
        read_only: true # Le conteneur ne fait que lire.
        bind: # Options du montage.
          create_host_path: false # Exige que le dossier ait été préparé par Ansible.
  registry-reader: # Service de téléchargement, en lecture seule, sur le même stockage.
    image: "{{ registry_image }}" # Même image que le service de publication.
    restart: unless-stopped # Redémarre le conteneur sauf s'il a été arrêté volontairement.
    ports: # Ports publiés sur l'hôte.
      - "{{ registry_lan_ip }}:{{ registry_pull_port }}:5000" # Les clients téléchargent sur ce port.
    environment: # Réglages de Distribution.
      REGISTRY_LOG_LEVEL: info # Niveau de détail des journaux.
      OTEL_TRACES_EXPORTER: none # Désactive l'envoi de traces vers un collecteur.
      REGISTRY_HTTP_TLS_CERTIFICATE: /tls/registry.crt # Certificat présenté aux clients.
      REGISTRY_HTTP_TLS_KEY: /tls/registry.key # Clé privée du serveur.
      REGISTRY_AUTH: htpasswd # Authentification par fichier de comptes.
      REGISTRY_AUTH_HTPASSWD_REALM: Homelab Registry Pull # Nom annoncé aux clients.
      REGISTRY_AUTH_HTPASSWD_PATH: /auth/htpasswd # Fichier des comptes de lecture.
      REGISTRY_STORAGE_MAINTENANCE: "readonly:\n  enabled: true\nuploadpurging:\n  enabled: false\n" # Bloc YAML attendu par Distribution 3.1.2 : lecture seule, sans purge.
    labels: # Étiquettes du conteneur.
      homelab.registry.auth-checksum: "{{ registry_auth_files.results[1].stat.checksum | default('pending') }}" # Change avec les comptes et force la recréation.
    volumes: # Dossiers de l'hôte montés dans le conteneur.
      - type: bind # Montage direct d'un dossier de l'hôte.
        source: "{{ registry_data_dir }}" # Images stockées sur l'hôte.
        target: /var/lib/registry # Emplacement attendu par Distribution.
        read_only: true # Docker interdit aussi l'écriture dans le dossier des images.
        bind: # Options du montage.
          create_host_path: false # Exige que le dossier ait été préparé par Ansible.
      - type: bind # Montage direct d'un dossier de l'hôte.
        source: "{{ registry_root }}/tls" # Clé et certificat.
        target: /tls # Chemin utilisé par les réglages TLS.
        read_only: true # Le conteneur ne fait que lire.
        bind: # Options du montage.
          create_host_path: false # Exige que le dossier ait été préparé par Ansible.
      - type: bind # Montage direct d'un dossier de l'hôte.
        source: "{{ registry_root }}/reader-auth" # Comptes de lecture.
        target: /auth # Chemin utilisé par l'authentification.
        read_only: true # Le conteneur ne fait que lire.
        bind: # Options du montage.
          create_host_path: false # Exige que le dossier ait été préparé par Ansible.
