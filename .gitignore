# Patterns valables pour tout le repo (chaque dossier peut ajouter
# son .gitignore local pour ses cas spécifiques).

# Environnements virtuels Python (dépendances locales, jamais versionnées)
.venv/
# Caches de bytecode Python
__pycache__/

# Config locale de l'éditeur Obsidian (préférences machine, pas de la doc)
.obsidian/
