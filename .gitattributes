# Les fichiers destinés au serveur Linux doivent rester en fins de ligne LF,
# même édités depuis Windows.
*.sh      text eol=lf
*.service text eol=lf
*.yml     text eol=lf

# Hooks git déployés sur le NAS : pas d'extension, donc visés nommément.
# Un CRLF ici casserait le shebang à l'exécution par /bin/sh.
deploiement/nas/post-receive text eol=lf
